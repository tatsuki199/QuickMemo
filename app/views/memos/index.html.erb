<div class="new_link" >
  <%= link_to "新規投稿", new_memo_path %>
</div>
<!-- app/views/images/index.html.erb -->
<%= form_with url: memos_path, method: :get, local: true do |f| %>
  <%= f.label :date, "投稿日で検索" %>
  <%= f.date_field :date %>
  <%= f.submit "検索" %>
<% end %>
<%= form_with url: memos_path,method: :get, local: true do |f| %> 
  <%= f.label :date, "期間で検索" %>
  <%= f.date_field :from %> 〜 <%= f.date_field :to %>
  <%= f.submit "検索" %>
<% end %>


<ul class="item-lists">
  <% @memos.each do |memo| %>
    <%= render partial: "memos/memo", locals: {memo: memo} %>
  <% end %>
</ul>