
<div class="show-item">
  <div class="top-title">
    <h2><%= @memo.title %></h2>
  <div>
  <div class="top-content">
    <% if user_signed_in? && current_user.id == @memo.user_id %>
      <ul>
        <li class="content">
          <%= link_to "編集", edit_memo_path(@memo.id) %>
        </li>
        <li class="content">
          <%= link_to "削除", memo_path(@memo.id), data: {turbo_method: :delete} %>
        </li>
      </ul>
    <% end %>
  </div>
  <%= image_tag @memo.image, class: "item-price-box" %>
  <div class="show-items"><%= @memo.detail %></div>
  <div class="show-items"><%= Category.find(@memo.category_id).name %></div>
  <div class="show-items importance"><%= Importance.find(@memo.importance_id).name %></div>
</div>